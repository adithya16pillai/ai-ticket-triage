# Copy to .env and fill in. The compose file sets DATABASE_URL for you.
DATABASE_URL=postgresql+psycopg2://triage:triage@localhost:5432/triage

# CORS origins for the SPA (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI triage ---
TRIAGE_ENABLED=true
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5-20251001
TRIAGE_MAX_TOKENS=512
TRIAGE_TIMEOUT_SECONDS=12
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# --- Auth (optional) ---
# Leave false for the single-agent demo (open API, audit events have no actor).
AUTH_ENABLED=false
JWT_SECRET=dev-only-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
